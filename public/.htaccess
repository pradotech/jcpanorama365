<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redirecionar HTTP para HTTPS automaticamente (se o SSL estiver ativo)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Se a requisição for para um arquivo ou diretório físico real, serve diretamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Fallback de Single Page Application (React Router): tudo o mais vai para index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Desabilitar listagem pública de diretórios
Options -Indexes

# Bloquear acesso direto a arquivos sensíveis caso sejam enviados por engano
<FilesMatch "^\.(env|git|oxlintrc)|(\.(sql|md|log))$">
  Require all denied
</FilesMatch>

# Configuração de tipos MIME essenciais
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg .svgz
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# Compressão GZIP / Deflate para ganho de performance e carregamento rápido
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# Controle de Cache:
# - index.html NUNCA deve ficar preso em cache (para o usuário sempre receber novas versões do app)
# - Assets estáticos com hash (/assets/*) podem ficar em cache longo
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </Files>
  <FilesMatch "\.(js|css|woff2|woff|ttf|png|jpg|jpeg|svg|webp|ico)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>
