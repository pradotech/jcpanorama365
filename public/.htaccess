<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redirecionar HTTP para HTTPS automaticamente (se o SSL estiver ativo)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Sitemap Dinâmico (sitemap.xml gerado via sitemap.php)
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # 3. Interceptar Robôs e Crawlers de Redes Sociais (WhatsApp, Facebook, Twitter, Telegram, LinkedIn, etc.)
  # Se for um bot acessando a página inicial / domínio raiz, encaminha para og.php?slug=home
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|Facebot|Twitterbot|TelegramBot|LinkedInBot|Pinterest|Slackbot|Discordbot|Googlebot|bingbot) [NC]
  RewriteRule ^$ og.php?slug=home [L,QSA]

  # Se for um bot acessando a rota de uma notícia (/noticia/:slug), encaminha para o og.php
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|WhatsApp|Facebot|Twitterbot|TelegramBot|LinkedInBot|Pinterest|Slackbot|Discordbot|Googlebot|bingbot) [NC]
  RewriteRule ^noticia/(.*)$ og.php?slug=$1 [L,QSA]

  # 4. Se a requisição for para um arquivo ou diretório físico real, serve diretamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. Fallback de Single Page Application (React Router): usuários normais vão para index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Desabilitar listagem pública de diretórios
Options -Indexes

# Bloquear acesso direto a arquivos sensíveis caso sejam enviados por engano
<FilesMatch "^\.(env|git|oxlintrc)|(\.(sql|md|log))$">
  Require all denied
</FilesMatch>

# Configuração de tipos MIME essenciais
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg .svgz
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# Compressão GZIP / Deflate para ganho de performance e carregamento rápido
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml application/xml
</IfModule>

# Controle de Cache:
# - index.html, sw.js e version.json NUNCA devem ficar presos em cache
# - Assets estáticos com hash (/assets/*) podem ficar em cache longo
<IfModule mod_headers.c>
  # Assets estáticos com hash
  <FilesMatch "^(?!sw\.js)(?!index\.html)(?!version\.json).*\.(js|css|woff2|woff|ttf|png|jpg|jpeg|svg|webp|ico)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # Arquivos de controle e ciclo de vida: NUNCA armazenar em cache
  <FilesMatch "^(index\.html|sw\.js|version\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>

  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>

  <Files "version.json">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>
</IfModule>
