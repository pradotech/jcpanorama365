{
  "rewrites": [
    {
      "source": "/noticia/:slug*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|whatsapp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|LinkedInBot|Pinterest|Slackbot|Discordbot|Googlebot|bingbot).*"
        }
      ],
      "destination": "/api/og?slug=:slug*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
